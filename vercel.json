{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "memory": 2048,
      "maxDuration": 60,
      "excludeFiles": "{.venv/**,.git/**,.taste-skill/**,logs/**,docs/**,*.ipynb,*.pdf,**/*.parquet,**/*.joblib,Flight_Data_With_Weather_Final.csv}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
